def _prepare_files():
    config = {
        'whatsapp': WHATSAPP_NUMBER,
        'phone': PHONE_NUMBER,
        'defaultLanguage': DEFAULT_LANGUAGE,
        'mapEmbedUrl': MAP_EMBED_URL,
        'exactMap': MAP_IS_EXACT,
    }
    # Escape < so editable settings cannot terminate the script element.
    config_json = json.dumps(config, ensure_ascii=False).replace('<', '\u003c')
    html = _HTML.replace(
        '<script src="app.js" defer></script>',
        '<script>window.LUNERA_CONFIG = ' + config_json + ';</script>\n'
        '  <script src="app.js" defer></script>',
    ).replace('https://maps.app.goo.gl/DB8qc6tg6xwnbbGj9?g_st=ic',
              MAP_DIRECTIONS_URL.replace('&', '&amp;').replace('"', '&quot;'))
    result = {
        '/': ('text/html; charset=utf-8', html.encode('utf-8')),
        '/index.html': ('text/html; charset=utf-8', html.encode('utf-8')),
        '/style.css': ('text/css; charset=utf-8', _CSS.encode('utf-8')),
        '/app.js': ('text/javascript; charset=utf-8', _JS.encode('utf-8')),
    }
    for path, (content_type, encoded) in _ASSET_DATA.items():
        result[path] = (content_type, base64.b64decode(encoded))
    return result


_FILES = _prepare_files()
_ETAGS = {path: '"' + hashlib.sha256(data).hexdigest() + '"'
          for path, (_, data) in _FILES.items()}


def app(environ, start_response):
    """WSGI entry point. Serves only the embedded, known website routes."""
    method = environ.get('REQUEST_METHOD', 'GET').upper()
    if method not in ('GET', 'HEAD'):
        body = b'Method not allowed'
        start_response('405 Method Not Allowed', [
            ('Content-Type', 'text/plain; charset=utf-8'),
            ('Content-Length', str(len(body))), ('Allow', 'GET, HEAD')])
        return [body]
    path = unquote(environ.get('PATH_INFO', '/') or '/')
    entry = _FILES.get(path)
    if entry is None:
        body = b'Page not found'
        start_response('404 Not Found', [
            ('Content-Type', 'text/plain; charset=utf-8'),
            ('Content-Length', str(len(body)))])
        return [] if method == 'HEAD' else [body]
    content_type, body = entry
    etag = _ETAGS[path]
    cache_control = 'no-cache' if content_type.startswith('text/html') else 'public, max-age=86400'
    headers = [('Content-Type', content_type), ('ETag', etag),
               ('Cache-Control', cache_control), ('X-Content-Type-Options', 'nosniff')]
    if environ.get('HTTP_IF_NONE_MATCH') == etag:
        start_response('304 Not Modified', [('ETag', etag), ('Cache-Control', cache_control)])
        return []
    headers.append(('Content-Length', str(len(body))))
    start_response('200 OK', headers)
    return [] if method == 'HEAD' else [body]


class _ThreadedServer(ThreadingMixIn, WSGIServer):
    daemon_threads = True


if __name__ == '__main__':
    with make_server(HOST, PORT, app, server_class=_ThreadedServer) as server:
        print(f'LUNERA SPA is running at http://localhost:{PORT}', flush=True)
        print('Press Ctrl+C to stop.', flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print('\nServer stopped.', flush=True)
