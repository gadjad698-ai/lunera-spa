function renderTreatments(){
  const container=document.getElementById('treatment-list');
  container.innerHTML='';
  treatments.filter(t=>filter==='all'||t.type===filter).forEach(t=>{
    const card=document.createElement('article');card.className='treatment-card';
    const details=document.createElement('div');details.className='treatment-details';
    const name=document.createElement('h3');name.textContent=t[lang];
    const sub=document.createElement('div');sub.className='treatment-sub';
    const secondary=document.createElement('span');secondary.textContent=t[lang==='en'?'ar':'en'];secondary.lang=lang==='en'?'ar':'en';secondary.dir=lang==='en'?'rtl':'ltr';
    sub.append(secondary,document.createElement('br'),document.createTextNode(t.minutes+' '+copy[lang].minute));details.append(name,sub);
    const action=document.createElement('div');action.className='treatment-action';
    const amount=document.createElement('div');amount.className='treatment-price';amount.append(document.createTextNode(t.price.toLocaleString('en-US')));const unit=document.createElement('small');unit.textContent=copy[lang].aed;amount.append(unit);
    const button=document.createElement('button');button.textContent=copy[lang].book;button.setAttribute('aria-label',copy[lang].book+' '+t[lang]);button.addEventListener('click',()=>choose(t.id));
    action.append(amount,button);card.append(details,action);container.append(card);
  });
  observeReveals(container.querySelectorAll('.treatment-card'));
}
