const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const revealObserver=(!reducedMotion&&'IntersectionObserver' in window)?new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target);}});},{threshold:.08}):null;
function observeReveals(elements){if(!revealObserver)return;elements.forEach((el,i)=>{el.classList.add('reveal');el.style.setProperty('--reveal-delay',Math.min(i%3,2)*70+'ms');revealObserver.observe(el);});}
